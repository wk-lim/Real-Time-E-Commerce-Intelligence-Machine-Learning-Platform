# Runtime environment: development, test, or production
APP_ENV=development

# Application logging verbosity
LOG_LEVEL=INFO

# Apache Kafka local-development configuration
KAFKA_VERSION=4.3.1
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_EVENTS_TOPIC=ecommerce.events.v1
KAFKA_PRODUCTS_TOPIC=ecommerce.products.v1
KAFKA_DLQ_TOPIC=ecommerce.events.dlq.v1
